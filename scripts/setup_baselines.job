#!/usr/bin/env bash
#SBATCH --job-name=setup-baselines-job
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}"
REPO_ROOT="$(cd "$REPO_ROOT" && pwd)"
if [[ -z "${SCRATCH_ROOT:-}" && -n "${SKILL_MINING_ROOT:-}" ]]; then
  SCRATCH_ROOT="$SKILL_MINING_ROOT"
elif [[ -z "${SCRATCH_ROOT:-}" && -n "${SCRATCH:-}" ]]; then
  SCRATCH_ROOT="${SCRATCH%/}/skill-mining"
elif [[ -z "${SCRATCH_ROOT:-}" && "$(basename "$REPO_ROOT")" == src ]]; then
  SCRATCH_ROOT="$(cd "$REPO_ROOT/.." && pwd)"
elif [[ -z "${SCRATCH_ROOT:-}" ]]; then
  SCRATCH_ROOT="$REPO_ROOT"
fi
readonly REPO_ROOT SCRATCH_ROOT
readonly DATA_ROOT=${BASELINE_DATA_ROOT:-${SCRATCH_ROOT}/data}
readonly VENV_PATH="${SCRATCH_ROOT}/.venv"
readonly IMAGE_PATH="${SCRATCH_ROOT}/containers/vllm-openai-v0.26.0-cu129.sif"

module load python/3.11.11-5e66
export PYTHONPATH="${REPO_ROOT}"
export UV_CACHE_DIR="${SCRATCH_ROOT}/uv-cache"
export APPTAINER_CACHEDIR="${SCRATCH_ROOT}/containers/cache"
export TMPDIR="${SCRATCH_ROOT}/tmp"

mkdir -p \
  "${UV_CACHE_DIR}" "${APPTAINER_CACHEDIR}" "${TMPDIR}" \
  "${SCRATCH_ROOT}/logs" "${SCRATCH_ROOT}/outputs"

if [[ ! -x "${VENV_PATH}/bin/python" ]]; then
  uv venv --python python "${VENV_PATH}"
fi
uv pip install \
  --python "${VENV_PATH}/bin/python" \
  --requirement "${REPO_ROOT}/requirements.txt"

cd "${REPO_ROOT}"
"${VENV_PATH}/bin/python" -m retrieval.data --data-root "${DATA_ROOT}"

if [[ ! -f "${IMAGE_PATH}" ]]; then
  apptainer pull "${IMAGE_PATH}" docker://vllm/vllm-openai:v0.26.0-cu129
fi
apptainer exec --no-home "${IMAGE_PATH}" python3 -c \
  'import vllm; print("vllm", vllm.__version__)'
