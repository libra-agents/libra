#!/usr/bin/env bash
#SBATCH --job-name=rerank-scikg-qwen-job
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --exclude=gpu2708
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=01:00:00
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err

set -euo pipefail
REPO_ROOT="${REPO_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}"
REPO_ROOT="$(cd "$REPO_ROOT" && pwd)"
if [[ -z "${SCRATCH_ROOT:-}" && -n "${SKILL_MINING_ROOT:-}" ]]; then
  SCRATCH_ROOT="$SKILL_MINING_ROOT"
elif [[ -z "${SCRATCH_ROOT:-}" && -n "${SCRATCH:-}" ]]; then
  SCRATCH_ROOT="${SCRATCH%/}/skill-mining"
elif [[ -z "${SCRATCH_ROOT:-}" && "$(basename "$REPO_ROOT")" == src ]]; then
  SCRATCH_ROOT="$(cd "$REPO_ROOT/.." && pwd)"
elif [[ -z "${SCRATCH_ROOT:-}" ]]; then
  SCRATCH_ROOT="$REPO_ROOT"
fi
readonly REPO_ROOT SCRATCH_ROOT
readonly RUN_ROOT="${SCRATCH_ROOT}/scikg/qwen3_embedding_0.6b_catalog477"
readonly IMAGE_PATH="${SCRATCH_ROOT}/containers/vllm-openai-v0.26.0-cu129.sif"
readonly VENV_PYTHON="${SCRATCH_ROOT}/.venv/bin/python"
readonly TEMPLATE="${REPO_ROOT}/agentic_retrieval/qwen3_reranker.jinja"
readonly PORT=$((10000 + (SLURM_JOB_ID + UID * 977) % 40000))
module load python/3.11.11-5e66
export PYTHONPATH="${REPO_ROOT}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export HF_HOME="${SCRATCH_ROOT}/huggingface" VLLM_CACHE_ROOT="${SCRATCH_ROOT}/vllm" XDG_CACHE_HOME="${SCRATCH_ROOT}/cache" TMPDIR="${SCRATCH_ROOT}/tmp" FLASHINFER_WORKSPACE_BASE="${SCRATCH_ROOT}/flashinfer" TRITON_CACHE_DIR="${SCRATCH_ROOT}/triton" CUDA_CACHE_PATH="${SCRATCH_ROOT}/cuda" PYTHONNOUSERSITE=1
for name in HF_HOME VLLM_CACHE_ROOT XDG_CACHE_HOME TMPDIR FLASHINFER_WORKSPACE_BASE TRITON_CACHE_DIR CUDA_CACHE_PATH PYTHONNOUSERSITE; do export "APPTAINERENV_${name}=${!name}"; done
mkdir -p "${RUN_ROOT}" "${SCRATCH_ROOT}/logs"
container_exec=(apptainer exec --nv --no-home --bind "${REPO_ROOT}:${REPO_ROOT}" --bind "${SCRATCH_ROOT}:${SCRATCH_ROOT}" "${IMAGE_PATH}")
"${container_exec[@]}" vllm serve Qwen/Qwen3-Reranker-0.6B --runner pooling \
  --host 127.0.0.1 --port "${PORT}" --dtype auto --max-model-len 8192 \
  --gpu-memory-utilization 0.9 --kv-cache-memory-bytes 1073741824 \
  --hf-overrides '{"architectures":["Qwen3ForSequenceClassification"],"classifier_from_token":["no","yes"],"is_original_qwen3_reranker":true}' \
  --chat-template "${TEMPLATE}" >"${SCRATCH_ROOT}/logs/scikg-rerank-server-${SLURM_JOB_ID}.log" 2>&1 &
server_pid=$!
trap 'kill "${server_pid}" 2>/dev/null || true; wait 2>/dev/null || true' EXIT INT TERM
for attempt in $(seq 1 120); do
  kill -0 "${server_pid}" 2>/dev/null || { echo 'Reranker exited.' >&2; exit 1; }
  curl --silent --fail "http://127.0.0.1:${PORT}/health" >/dev/null && break
  [[ "${attempt}" -eq 120 ]] && { echo 'Reranker timeout.' >&2; exit 1; }
  sleep 5
done
cd "${REPO_ROOT}"
"${VENV_PYTHON}" -m scripts.rerank_scikg_retrieval \
  --first-stage "${RUN_ROOT}/first_stage.json" \
  --tool-registry "dataset and embedding/scitool_clean/tool_registry.json" \
  --output "${RUN_ROOT}/reranked_predictions.jsonl" \
  --metrics-output "${RUN_ROOT}/reranked_metrics.json" \
  --base-url "http://127.0.0.1:${PORT}"
