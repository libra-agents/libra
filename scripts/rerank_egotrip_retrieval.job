#!/usr/bin/env bash
#SBATCH --job-name=rerank-egotrip-retrieval-job
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --exclude=gpu2708
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=03:00:00
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}"
REPO_ROOT="$(cd "$REPO_ROOT" && pwd)"
if [[ -z "${SCRATCH_ROOT:-}" && -n "${SKILL_MINING_ROOT:-}" ]]; then
  SCRATCH_ROOT="$SKILL_MINING_ROOT"
elif [[ -z "${SCRATCH_ROOT:-}" && -n "${SCRATCH:-}" ]]; then
  SCRATCH_ROOT="${SCRATCH%/}/skill-mining"
elif [[ -z "${SCRATCH_ROOT:-}" && "$(basename "$REPO_ROOT")" == src ]]; then
  SCRATCH_ROOT="$(cd "$REPO_ROOT/.." && pwd)"
elif [[ -z "${SCRATCH_ROOT:-}" ]]; then
  SCRATCH_ROOT="$REPO_ROOT"
fi
readonly REPO_ROOT SCRATCH_ROOT
readonly DATA_ROOT=${BASELINE_DATA_ROOT:-${SCRATCH_ROOT}/data}
readonly IMAGE_PATH="${SCRATCH_ROOT}/containers/vllm-openai-v0.26.0-cu129.sif"
readonly VENV_PYTHON="${SCRATCH_ROOT}/.venv/bin/python"
readonly TEMPLATE="${REPO_ROOT}/agentic_retrieval/qwen3_reranker.jinja"
readonly PORT=$((10000 + (SLURM_JOB_ID + UID * 983) % 40000))

module load python/3.11.11-5e66
export PYTHONPATH="${REPO_ROOT}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export HF_HOME="${SCRATCH_ROOT}/huggingface"
export HUGGINGFACE_HUB_CACHE="${HF_HOME}/hub"
export VLLM_CACHE_ROOT="${SCRATCH_ROOT}/vllm"
export XDG_CACHE_HOME="${SCRATCH_ROOT}/cache"
export XDG_CONFIG_HOME="${SCRATCH_ROOT}/config"
export TMPDIR="${SCRATCH_ROOT}/tmp"
export FLASHINFER_WORKSPACE_BASE="${SCRATCH_ROOT}/flashinfer"
export TORCHINDUCTOR_CACHE_DIR="${SCRATCH_ROOT}/torchinductor"
export TRITON_CACHE_DIR="${SCRATCH_ROOT}/triton"
export CUDA_CACHE_PATH="${SCRATCH_ROOT}/cuda"
export PYTHONNOUSERSITE=1
export APPTAINERENV_PYTHONNOUSERSITE=1
export APPTAINERENV_HF_HOME="${HF_HOME}"
export APPTAINERENV_HUGGINGFACE_HUB_CACHE="${HUGGINGFACE_HUB_CACHE}"
export APPTAINERENV_VLLM_CACHE_ROOT="${VLLM_CACHE_ROOT}"
export APPTAINERENV_XDG_CACHE_HOME="${XDG_CACHE_HOME}"
export APPTAINERENV_XDG_CONFIG_HOME="${XDG_CONFIG_HOME}"
export APPTAINERENV_TMPDIR="${TMPDIR}"
export APPTAINERENV_FLASHINFER_WORKSPACE_BASE="${FLASHINFER_WORKSPACE_BASE}"
export APPTAINERENV_TORCHINDUCTOR_CACHE_DIR="${TORCHINDUCTOR_CACHE_DIR}"
export APPTAINERENV_TRITON_CACHE_DIR="${TRITON_CACHE_DIR}"
export APPTAINERENV_CUDA_CACHE_PATH="${CUDA_CACHE_PATH}"

mkdir -p \
  "${HF_HOME}" "${VLLM_CACHE_ROOT}" "${XDG_CACHE_HOME}" \
  "${XDG_CONFIG_HOME}" "${TMPDIR}" "${FLASHINFER_WORKSPACE_BASE}" \
  "${TORCHINDUCTOR_CACHE_DIR}" "${TRITON_CACHE_DIR}" "${CUDA_CACHE_PATH}" \
  "${SCRATCH_ROOT}/logs" \
  "${SCRATCH_ROOT}/outputs/retrieval/egotrip"

container_exec=(
  apptainer exec --nv --no-home
  --bind "${REPO_ROOT}:${REPO_ROOT}"
  --bind "${SCRATCH_ROOT}:${SCRATCH_ROOT}"
  "${IMAGE_PATH}"
)

"${container_exec[@]}" vllm serve Qwen/Qwen3-Reranker-0.6B \
  --runner pooling \
  --host 127.0.0.1 \
  --port "${PORT}" \
  --dtype auto \
  --max-model-len 8192 \
  --gpu-memory-utilization 0.9 \
  --kv-cache-memory-bytes 1073741824 \
  --hf-overrides \
  '{"architectures":["Qwen3ForSequenceClassification"],"classifier_from_token":["no","yes"],"is_original_qwen3_reranker":true}' \
  --chat-template "${TEMPLATE}" \
  >"${SCRATCH_ROOT}/logs/egotrip-rerank-server-${SLURM_JOB_ID}.log" 2>&1 &
server_pid=$!
trap 'kill "${server_pid}" 2>/dev/null || true; wait 2>/dev/null || true' EXIT INT TERM

for attempt in $(seq 1 120); do
  if ! kill -0 "${server_pid}" 2>/dev/null; then
    echo "Reranker server exited during startup." >&2
    exit 1
  fi
  if curl --silent --fail "http://127.0.0.1:${PORT}/health" >/dev/null; then
    break
  fi
  if [[ "${attempt}" -eq 120 ]]; then
    echo "Timed out waiting for reranker server." >&2
    exit 1
  fi
  sleep 5
done

cd "${REPO_ROOT}"
for dataset in ${EGO_DATASETS:-appworld bfcl}; do
  if [[ "${dataset}" == "scitool" ]]; then
    data_dir="${REPO_ROOT}/dataset and embedding/scitool_clean"
  else
    data_dir="${DATA_ROOT}/${dataset}"
  fi
  "${VENV_PYTHON}" -m scripts.rerank_egotrip_retrieval \
    --data-dir "${data_dir}" \
    --candidates "${SCRATCH_ROOT}/outputs/retrieval/egotrip/${dataset}_budget_top20.jsonl" \
    --output "${SCRATCH_ROOT}/outputs/retrieval/egotrip/${dataset}_budget_reranked_top20.jsonl" \
    --metrics-output "${SCRATCH_ROOT}/outputs/retrieval/egotrip/${dataset}_budget_reranked_metrics.json" \
    --base-url "http://127.0.0.1:${PORT}" \
    --top-k 20 \
    --concurrency 16
done
