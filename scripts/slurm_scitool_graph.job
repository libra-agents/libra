#!/usr/bin/env bash
#SBATCH --job-name=scitool-dependency-graph-job
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=96
#SBATCH --mem=128G
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err

set -euo pipefail
set +x
unset DASHSCOPE_API_KEY OPENROUTER_API_KEY EMBEDDING_API_KEY

SRC="${REPO_ROOT:-${SLURM_SUBMIT_DIR:-$PWD}}"
SRC="$(cd "$SRC" && pwd)"
ROOT="${SKILL_MINING_ROOT:-${SCRATCH_ROOT:-}}"
if [[ -z "$ROOT" && -n "${SCRATCH:-}" ]]; then
  ROOT="${SCRATCH%/}/skill-mining"
elif [[ -z "$ROOT" && "$(basename "$SRC")" == src ]]; then
  ROOT="$(cd "$SRC/.." && pwd)"
elif [[ -z "$ROOT" ]]; then
  ROOT="$SRC"
fi
VENV="$ROOT/.venv"
DATA="$SRC/dataset and embedding/scitool_clean"
IMAGE="$ROOT/containers/vllm-openai-v0.26.0-cu129.sif"
MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDINGS="$ROOT/embeddings/qwen3_embedding_0.6b_v1"
SIF="$ROOT/runtime/scitool-baseline.sif"
PACKAGES="$ROOT/runtime/scitool-python"
TOOLS="$SRC/SciToolAgent-main/ToolsAgent"
SERVER="$SRC/scitool_container/tool_server.py"
MODE="${MODE:-fresh}"
WARM_CONTRACTS="${WARM_CONTRACTS:-$DATA/contracts.json}"
MAX_CALLS=100000
RUN="$ROOT/runs/scitool-${MODE}-${SLURM_JOB_ID}"
JOBTMP="${SLURM_TMPDIR:-$ROOT/jobtmp}/skill-mining-$SLURM_JOB_ID"
WORK="$JOBTMP/work"
PORT=$((10000 + SLURM_JOB_ID % 40000))
BASE_URL="http://127.0.0.1:$PORT/v1"
TOOL_PORT=$((20000 + SLURM_JOB_ID % 30000))
QWEN_PID=
TOOL_PIDS=()
SERVICE_ARGS=()

module load python/3.11.11-5e66
source "$VENV/bin/activate"
export PYTHONPATH="$SRC"
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost
export HF_HOME="$ROOT/huggingface"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export XDG_CACHE_HOME="$JOBTMP/cache" TMPDIR="$JOBTMP/tmp"
export VLLM_CACHE_ROOT="$JOBTMP/vllm"
export FLASHINFER_WORKSPACE_BASE="$JOBTMP/flashinfer"
export TORCHINDUCTOR_CACHE_DIR="$JOBTMP/torchinductor"
export TRITON_CACHE_DIR="$JOBTMP/triton" CUDA_CACHE_PATH="$JOBTMP/cuda"
export VLLM_NO_USAGE_STATS=1
export APPTAINERENV_HF_HOME="$HF_HOME"
export APPTAINERENV_HUGGINGFACE_HUB_CACHE="$HUGGINGFACE_HUB_CACHE"
export APPTAINERENV_XDG_CACHE_HOME="$XDG_CACHE_HOME"
export APPTAINERENV_TMPDIR="$TMPDIR"
export APPTAINERENV_VLLM_CACHE_ROOT="$VLLM_CACHE_ROOT"
export APPTAINERENV_FLASHINFER_WORKSPACE_BASE="$FLASHINFER_WORKSPACE_BASE"
export APPTAINERENV_TORCHINDUCTOR_CACHE_DIR="$TORCHINDUCTOR_CACHE_DIR"
export APPTAINERENV_TRITON_CACHE_DIR="$TRITON_CACHE_DIR"
export APPTAINERENV_CUDA_CACHE_PATH="$CUDA_CACHE_PATH"
export APPTAINERENV_VLLM_NO_USAGE_STATS=1
export APPTAINERENV_TOOLS_DIR=/app/ToolsAgent
export APPTAINERENV_PYTHONUNBUFFERED=1
export APPTAINERENV_PYTHONPATH=/opt/scitool-python:/app/ToolsAgent

cleanup() {
  if [[ -n "$QWEN_PID" ]]; then
    kill -9 "$QWEN_PID" >/dev/null 2>&1 || true
  fi
  for pid in "${TOOL_PIDS[@]}"; do
    kill -9 "$pid" >/dev/null 2>&1 || true
  done
  rm -rf "$JOBTMP"
}
trap cleanup EXIT

[[ "$MODE" == fresh || "$MODE" == warm ]]
[[ "$MODE" == warm ]] && test -s "$WARM_CONTRACTS"
[[ "$MODE" == warm || -n "${DEEPSEEK_API_KEY:-}" ]]
test -s "$IMAGE"
test -s "$SIF"
test -e "$PACKAGES/READY"
test -s "$DATA/tool_registry.json"
test -s "$EMBEDDINGS/scitool_clean/tool_embeddings.npz"
test -s "$EMBEDDINGS/scitool_clean/query_embeddings.npz"
test ! -e "$RUN"
mkdir -p "$RUN" "$WORK/discovery" "$XDG_CACHE_HOME" "$TMPDIR" \
  "$VLLM_CACHE_ROOT" "$FLASHINFER_WORKSPACE_BASE" \
  "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR" "$CUDA_CACHE_PATH"

printf 'CONFIG job=%s benchmark=scitool mode=%s calls=%s workers=96 round=768 ipc=1 services=12\n' \
  "$SLURM_JOB_ID" "$MODE" "$MAX_CALLS"
printf 'MODELS deepseek=https://api.deepseek.com model=deepseek-v4-flash qwen=%s\n' \
  "$MODEL"
df -h "$ROOT"
df -i "$ROOT"

apptainer exec --nv --no-home --bind "$ROOT:$ROOT" --bind "$JOBTMP:$JOBTMP" \
  "$IMAGE" vllm serve "$MODEL" --runner pooling --host 127.0.0.1 \
  --port "$PORT" --dtype auto --max-model-len 8192 \
  > "$RUN/qwen-server.log" 2>&1 &
QWEN_PID=$!
for _ in $(seq 1 120); do
  kill -0 "$QWEN_PID" 2>/dev/null || exit 1
  curl --fail --silent "http://127.0.0.1:$PORT/health" >/dev/null && break
  sleep 5
done
curl --fail --silent "http://127.0.0.1:$PORT/health" >/dev/null

if [[ "$MODE" == fresh ]]; then
  python -m retrieval.build_contracts scitool --data-dir "$DATA" \
    --output "$WORK/contracts.json" | tee "$RUN/contracts.log"
else
  cp "$WARM_CONTRACTS" "$WORK/contracts.json"
fi
for descriptor in field context; do
  python -m retrieval.build_field_embeddings scitool --data-dir "$DATA" \
    --contracts "$WORK/contracts.json" --output "$WORK/$descriptor.sqlite" \
    --descriptor "$descriptor" --embedding-base-url "$BASE_URL" \
    > "$RUN/$descriptor-embeddings.json"
done

for index in $(seq 0 11); do
  port=$((TOOL_PORT + index))
  APPTAINERENV_TOOL_SERVER_PORT=$port apptainer exec --cleanenv \
    --bind "$TOOLS:/app/ToolsAgent:ro" --bind "$SERVER:/app/tool_server.py:ro" \
    --bind "$PACKAGES:/opt/scitool-python:ro" "$SIF" \
    python /app/tool_server.py > "$JOBTMP/tool-server-$index.log" 2>&1 &
  TOOL_PIDS+=("$!")
  SERVICE_ARGS+=(--service-url "http://127.0.0.1:$port/invoke")
done
deadline=$((SECONDS + 240))
while true; do
  ready=0
  for index in $(seq 0 11); do
    curl --fail --silent "http://127.0.0.1:$((TOOL_PORT + index))/health" \
      >/dev/null && ready=$((ready + 1))
  done
  printf '%s TOOL_SERVERS ready=%s/12\n' "$(date -Is)" "$ready"
  [[ "$ready" -eq 12 ]] && break
  [[ "$SECONDS" -ge "$deadline" ]] && exit 1
  sleep 2
done

python -m retrieval.adapters.scitool --mode "$MODE" \
  --registry "$DATA/tool_registry.json" "${SERVICE_ARGS[@]}" --tool-timeout 10 \
  --contracts "$WORK/contracts.json" --field-embeddings "$WORK/field.sqlite" \
  --scheduling-field-embeddings "$WORK/context.sqlite" \
  --work-dir "$WORK/discovery" --output "$RUN/raw-graph.json" \
  --telemetry-output "$RUN/telemetry.jsonl" --max-calls "$MAX_CALLS" \
  --embedding-base-url "$BASE_URL" | tee "$RUN/build.log"

python -m retrieval.publish_graph scitool --data-dir "$DATA" \
  --raw-graph "$RUN/raw-graph.json" --contracts "$WORK/contracts.json" \
  --field-embeddings "$WORK/field.sqlite" \
  --output "$RUN/dependency_graph.json" --contracts-output "$RUN/contracts.json"
cp "$WORK/discovery/evidence.jsonl" "$RUN/evidence.jsonl"
python -m retrieval.retrieve scitool --embedding-root "$EMBEDDINGS" \
  --output-dir "$RUN/retrieval"
touch "$RUN/COMPLETE"
du -sh "$RUN"
